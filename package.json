{
	"name": "@bruhabruh/theme",
	"type": "module",
	"version": "4.1.1",
	"description": "BruhaBruh Theme with CLI",
	"author": "BruhaBruh",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/bruhabruh/theme"
	},
	"keywords": [],
	"bin": "./dist/cli.mjs",
	"files": [
		"dist",
		"template"
	],
	"scripts": {
		"build": "tsup",
		"generate": "pnpm run build && node ./dist/cli.mjs generate",
		"generate:schemes": "tsx ./src/generate-schemes.ts",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint . --report-unused-disable-directives",
		"prepare": "husky"
	},
	"dependencies": {
		"@material/material-color-utilities": "^0.3.0",
		"chalk": "^5.6.2",
		"commander": "^14.0.3",
		"culori": "^4.0.2",
		"glob": "^13.0.4",
		"math-expression-evaluator": "^2.0.7",
		"ts-deepmerge": "^7.0.3",
		"yaml": "^2.8.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^7.4.3",
		"@bruhabruh/tsconfig": "^1.0.4",
		"@bruhabruh/type-safe": "^1.3.0",
		"@commitlint/cli": "^20.4.1",
		"@commitlint/config-conventional": "^20.4.1",
		"@commitlint/types": "^20.4.0",
		"@types/culori": "^4.0.1",
		"@types/eslint": "^9.6.1",
		"@types/node": "^25.2.3",
		"@vitest/coverage-v8": "^4.0.18",
		"eslint": "^10.0.0",
		"eslint-plugin-format": "^1.4.0",
		"husky": "^9.1.7",
		"nano-staged": "^0.9.0",
		"tailwindcss": "^4.1.18",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"nano-staged": {
		"*.{js,ts,md,yaml,yml,json}": [
			"eslint --fix --quiet --report-unused-disable-directives"
		]
	}
}
