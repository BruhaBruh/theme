{
	"extends": "@bruhabruh/tsconfig/tsconfig.json",
	"compilerOptions": {
		"composite": false,
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"./src/*"
			]
		},
		"types": [
			"vitest/globals"
		],
		"outDir": "dist"
	},
	"include": [
		"src",
		"*.ts",
		"**/*.test.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"coverage"
	]
}
